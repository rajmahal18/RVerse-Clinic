DATABASE_URL="postgresql://clinic:clinic_password@localhost:5433/clinic_system?schema=public"
DIRECT_URL="postgresql://clinic:clinic_password@localhost:5433/clinic_system?schema=public"
# Above URLs are local development examples only. Production: private DB, unique
# credentials, and verified TLS for remote connections per OCM IT policy.
# Production requires an independent random secret, at least 32 characters.
AUTH_SECRET="replace-with-a-long-random-secret"
# Local HTTP only. Production enforces secure cookies; set true for HTTPS.
AUTH_COOKIE_SECURE="false"
# Enable only when direct app access is blocked and the trusted proxy overwrites
# forwarded headers. See docs/ocm-deployment.md.
TRUST_PROXY_HEADERS="false"
NEXT_PUBLIC_APP_NAME="The Clinic"
NEXT_PUBLIC_APP_MODE="layout"
# Permanent origin used by printed patient QR labels (e.g. https://clinic.example.gov).
# If empty, the current request host is used. Set this before printing ID stickers.
APP_BASE_URL=""
# Manual one-time admin initialization only. Never set known/default credentials.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME=""
