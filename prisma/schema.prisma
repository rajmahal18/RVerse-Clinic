generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DOCTOR_NURSE
  SUPPLY_OFFICER
  RECORDS
}

enum PatientGender {
  MALE
  FEMALE
  OTHER
}

enum VisitStatus {
  QUEUED
  IN_PROGRESS
  FOR_FOLLOW_UP
  COMPLETED
  CANCELLED
}

enum RequestType {
  CONSULTATION
  MEDICINES
  CS_211_MEDICAL_CERTIFICATE
  REGULAR_MEDICAL_CERTIFICATE
  VACCINATION
  EMERGENCY
  MEDICAL_ALLOWANCE
  REFERRAL
}

enum InventoryCategory {
  MEDICINE
  VACCINE
  SUPPLY
  EQUIPMENT
}

model Clinic {
  id        String   @id @default(cuid())
  name      String
  address   String?
  contact   String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  patients       Patient[]
  inventory      InventoryItem[]
  activityLogs   ActivityLog[]
  vaccineCatalog VaccineCatalog[]
}

model User {
  id           String   @id @default(cuid())
  clinicId     String
  name         String
  email        String   @unique
  passwordHash String?
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  activityLogs ActivityLog[]
}

model ActivityLog {
  id          String   @id @default(cuid())
  clinicId    String?
  userId      String?
  module      String
  action      String
  status      String   @default("SUCCESS")
  entityType  String?
  entityId    String?
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clinicId, createdAt])
  @@index([userId, createdAt])
  @@index([module, createdAt])
  @@index([status, createdAt])
}

model Patient {
  id          String        @id @default(cuid())
  clinicId    String
  lastName    String
  firstName   String
  middleName  String?
  birthDate   DateTime
  gender      PatientGender
  address     String?
  contactNo   String?
  agency      String?
  designation String?
  civilStatus String?
  heightCm    Float?
  weightKg    Float?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  clinic Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  visits Visit[]

  @@index([clinicId, lastName, firstName])
}

model Visit {
  id              String      @id @default(cuid())
  patientId       String
  timeIn          DateTime
  timeOut         DateTime?
  chiefComplaint  String?
  bloodPressure   String?
  rbs             String?
  temperature     String?
  pulseRate       String?
  respiratoryRate String?
  diagnosis       String?
  treatmentPlan   String?
  progressNotes   String?
  status          VisitStatus @default(QUEUED)
  nurseOnDuty     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  patient      Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  requests     VisitRequest[]
  medicines    MedicineRequest[]
  referrals    Referral[]
  vaccinations VaccinationRecord[]
  followUps    FollowUp[]

  @@index([patientId, timeIn])
}

model VisitRequest {
  id        String      @id @default(cuid())
  visitId   String
  type      RequestType
  createdAt DateTime    @default(now())

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([visitId, type])
}

model MedicineRequest {
  id              String    @id @default(cuid())
  visitId         String
  inventoryItemId String?
  itemName        String
  quantity        Int
  frequency       String?
  duration        String?
  status          String    @default("REQUESTED")
  releasedBy      String?
  receivedBy      String?
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  visit         Visit               @relation(fields: [visitId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem?      @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  movements     InventoryMovement[]

  @@index([inventoryItemId])
}

model Referral {
  id                String   @id @default(cuid())
  visitId           String
  medicalHistory    String?
  reasonForReferral String?
  referredTo        String?
  remarks           String?
  createdAt         DateTime @default(now())

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)
}

model VaccinationRecord {
  id        String    @id @default(cuid())
  visitId   String
  vaccine   String
  dose      String?
  givenBy   String?
  nextDose  DateTime?
  remarks   String?
  createdAt DateTime  @default(now())

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)
}

model VaccineCatalog {
  id        String   @id @default(cuid())
  clinicId  String
  name      String
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, name])
  @@index([clinicId, name])
}

enum FollowUpStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model FollowUp {
  id           String         @id @default(cuid())
  visitId      String
  scheduledFor DateTime
  remarks      String?
  status       FollowUpStatus @default(SCHEDULED)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([scheduledFor, status])
  @@index([visitId])
}

model InventoryItem {
  id             String            @id @default(cuid())
  clinicId       String
  name           String
  dosage         String?
  brandName      String?
  classification String?
  pcsPerBox      Int?
  expirationDate DateTime?
  batchKey       String            @default(cuid())
  category       InventoryCategory
  stock          Int               @default(0)
  unit           String
  reorderLevel   Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  clinic           Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  movements        InventoryMovement[]
  medicineRequests MedicineRequest[]

  @@unique([clinicId, batchKey])
  @@index([clinicId, category])
  @@index([clinicId, name, expirationDate])
  @@index([expirationDate])
}

model InventoryMovement {
  id                String   @id @default(cuid())
  inventoryItemId   String
  medicineRequestId String?
  quantityChange    Int
  reason            String
  createdAt         DateTime @default(now())

  item            InventoryItem    @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  medicineRequest MedicineRequest? @relation(fields: [medicineRequestId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId, createdAt])
  @@index([medicineRequestId])
}
